# Core app
APP_ENV=local
LOG_LEVEL=INFO
CATALOG_PATH=data/catalog.seed.json
CACHE_PATH=data/cache.json
CACHE_NAMESPACE=style-agent-v3

# Embeddings: FastEmbed runs BAAI/bge-small-en-v1.5 locally, so there are no paid embedding API calls.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
ALLOW_EMBEDDING_FALLBACK=true

# Vector DB: local_json runs with zero services. Docker Compose overrides this to qdrant.
VECTOR_BACKEND=local_json
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=quickeee_catalog
QDRANT_RECREATE_ON_STARTUP=true
ALLOW_LOCAL_VECTOR_FALLBACK=true

# Optional LLM provider. Leave blank to use the deterministic local stylist.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Scraper controls
SCRAPER_DELAY_MIN_SECONDS=0.8
SCRAPER_DELAY_MAX_SECONDS=2.2
SCRAPER_TIMEOUT_SECONDS=30

# Free-tier protection for POST /api/v1/style-me. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=30
