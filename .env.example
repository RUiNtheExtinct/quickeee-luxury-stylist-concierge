# Core app
APP_ENV=local
LOG_LEVEL=INFO
CATALOG_PATH=data/catalog.seed.json
CACHE_PATH=data/cache.json
CACHE_NAMESPACE=style-agent-v4

# Embeddings: FastEmbed runs BAAI/bge-small-en-v1.5 locally, so there are no paid embedding API calls.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
ALLOW_EMBEDDING_FALLBACK=true

# Vector DB: use Qdrant Cloud for the hosted demo. Docker Compose overrides QDRANT_URL to qdrant.
VECTOR_BACKEND=qdrant
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=
QDRANT_COLLECTION=quickeee_catalog
QDRANT_RECREATE_ON_STARTUP=false
ALLOW_LOCAL_VECTOR_FALLBACK=false

# Hosted LLM provider. Set LLM_PROVIDER=local for a zero-key fallback.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Scraper controls
SCRAPER_DELAY_MIN_SECONDS=0.8
SCRAPER_DELAY_MAX_SECONDS=2.2
SCRAPER_TIMEOUT_SECONDS=30

# Free-tier protection for POST /api/v1/style-me. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=30
